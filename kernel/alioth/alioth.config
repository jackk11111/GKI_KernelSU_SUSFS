# Android runtime / boot
CONFIG_ANDROID_BINDER_IPC=y
CONFIG_ANDROID_BINDERFS=y
CONFIG_ANDROID_BINDER_DEVICES="binder,hwbinder,vndbinder"
CONFIG_ANDROID_VENDOR_HOOKS=y
CONFIG_ANDROID_VENDOR_OEM_DATA=y

# POCO F3 / SM8250 boot-critical filesystem and storage
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_EROFS_FS=y
CONFIG_OVERLAY_FS=y
CONFIG_DM_VERITY=y
CONFIG_DM_CRYPT=y
CONFIG_DM_DEFAULT_KEY=y
CONFIG_FS_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFS_QCOM=y

# Alioth mainline display and touch support
CONFIG_DRM=y
CONFIG_DRM_MSM=y
CONFIG_DRM_PANEL_SAMSUNG_AMS667XX01=y
CONFIG_TOUCHSCREEN_FT8756=y

# SM8250 connectivity and platform
CONFIG_ARCH_QCOM=y
CONFIG_PCI=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_RFKILL=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_RPMPD=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_QMI_HELPERS=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_RPM=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_MHI_BUS=y
CONFIG_MHI_BUS_PCI_GENERIC=y
CONFIG_ATH11K=y
CONFIG_ATH11K_PCI=y
CONFIG_BT=y
CONFIG_BT_QCA=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_QCOM_GENI_SE=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_QCOM_SPMI=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_TYPEC_QCOM_PMIC=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_SPMI_VADC=y
CONFIG_QCOM_SPMI_ADC5=y

# Qualcomm audio / camera mainline paths
CONFIG_SND_SOC=y
CONFIG_SND_SOC_QCOM=y
CONFIG_QCOM_APR=y
CONFIG_SOUNDWIRE=y
CONFIG_SND_SOC_SM8250=y
CONFIG_SND_SOC_CS35L41_I2C=y
CONFIG_SND_SOC_QDSP6=y
CONFIG_VIDEO_DEV=y
CONFIG_VIDEO_V4L2=y
CONFIG_VIDEO_QCOM_CAMSS=y

# Android security / tracing / module support
CONFIG_SECURITY=y
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_SELINUX_BOOTPARAM=y
CONFIG_SECURITY_SELINUX_DEVELOP=y
CONFIG_SECURITY_SELINUX_AVC_STATS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_PSI=y
CONFIG_KPROBES=y
CONFIG_KALLSYMS=y
CONFIG_KALLSYMS_ALL=y
CONFIG_FTRACE=y
CONFIG_FUNCTION_TRACER=y
CONFIG_FUNCTION_GRAPH_TRACER=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
# CONFIG_MODULE_SIG is not set

# KernelSU Next v3.4.2 built-in; SUSFS 2.3.0 is its matching external LKM
CONFIG_KSU=y
