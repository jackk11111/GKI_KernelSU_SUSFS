+/* Collect opaque benign secondary entries before any name entries are
+ * overwritten. In-place renames can move these entries over themselves.
+ */
+static int exfat_save_benign_entries(struct exfat_entry_set_cache *es,
+		struct exfat_dentry **saved)
+{
+	struct exfat_dentry *stream, *entries;
+	int i, first, count;
+
+	*saved = NULL;
+	stream = exfat_get_dentry_cached(es, ES_IDX_STREAM);
+	first = ES_IDX_FIRST_FILENAME +
+		EXFAT_FILENAME_ENTRY_NUM(stream->dentry.stream.name_len);
+	if (first > es->num_entries)
+		return -EIO;
+	count = es->num_entries - first;
+	if (!count)
+		return 0;
+
+	entries = kmalloc_array(count, sizeof(*entries), GFP_NOFS);
+	if (!entries)
+		return -ENOMEM;
+
+	for (i = 0; i < count; i++) {
+		struct exfat_dentry *ep = exfat_get_dentry_cached(es, first + i);
+
+		if (!(exfat_get_entry_type(ep) & TYPE_BENIGN_SEC)) {
+			kfree(entries);
+			return -EIO;
+		}
+		entries[i] = *ep;
+	}
+	*saved = entries;
+	return count;
+}
